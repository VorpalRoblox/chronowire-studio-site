---
import '../styles/global.css';
const { title='Chronowire Studio', description='Chronowire Studio — Digimon Odyssey updates and game database.', active='' } = Astro.props;
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title}</title></head><body>
<div class="site-grid" aria-hidden="true"></div>
<header class="nav-wrap"><div class="container nav">
  <a class="brand" href={url('/')}><img class="logo" src={url('/images/digimon-odyssey-icon.png')} alt=""/><span class="brand-copy"><b>CHRONOWIRE</b><small>STUDIO // ARCHIVE</small></span></a>
  <button class="hamb" id="menuButton" aria-label="Toggle navigation">MENU</button>
  <nav class="nav-links" id="navLinks"><a class:list={[active==='home'&&'active']} href={url('/')}><i>00</i>Index</a><a class:list={[active==='games'&&'active']} href={url('/games/')}><i>01</i>Games</a><a class:list={[active==='blogs'&&'active']} href={url('/blog/')}><i>02</i>Updates</a><a class:list={[active==='database'&&'active']} href={url('/database/')}><i>03</i>Database</a><a class="nav-cta" href="https://www.roblox.com/communities/4473875/Chronowire-Studio#!/about" target="_blank" rel="noreferrer">Roblox Group ↗</a></nav>
</div></header>
<slot/>
<footer class="footer"><div class="container footer-grid"><div><div class="micro">CHRONOWIRE STUDIO // SYSTEM FOOTER</div><p>Development records and field data for Chronowire Studio projects.</p></div><div><div class="footer-status"><span></span>ARCHIVE ONLINE</div><small>Digimon Odyssey // Project 01</small></div><div class="footer-links"><a href={url('/games/')}>Games</a><a href={url('/blog/')}>Updates</a><a href={url('/database/')}>Database</a></div></div></footer>
<script is:inline>document.getElementById('menuButton')?.addEventListener('click',()=>document.getElementById('navLinks')?.classList.toggle('open'));</script>
</body></html>

