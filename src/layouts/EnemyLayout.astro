---
import BaseLayout from './BaseLayout.astro';
const { entry } = Astro.props;
const data = entry.data;
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
const relatedUrl=(item)=>item.collection==='playable-digimon'?url(`/database/digimon/${item.slug}/`):item.collection==='enemies'?url(`/database/enemies/${item.slug}/`):url(`/database/${item.slug}/`);
const statRows=[['HP',data.stats.hp],['Attack',data.stats.attack],['Defense',data.stats.defense],['Speed',data.stats.speed],...Object.entries(data.stats.additional)];
const rewardGroups=[['EXP',data.rewards.exp?[String(data.rewards.exp)]:[]],['CURRENCY',data.rewards.currency?[data.rewards.currency]:[]],['GUARANTEED DROPS',data.rewards.guaranteedDrops],['NORMAL DROPS',data.rewards.normalDrops],['RARE DROPS',data.rewards.rareDrops],['FIRST-CLEAR REWARDS',data.rewards.firstClear],['QUEST REWARDS',data.rewards.questRewards]];
---
<BaseLayout title={`${data.title} — ${data.type} Archive`} description={data.description} active="database"><main class="record-page enemy-record">
<header class="record-head"><div class="container"><div class="breadcrumb"><a href={url('/database/')}>ODYSSEY DATABASE</a> / {data.type.toUpperCase()} / <span>{data.slug.toUpperCase()}</span></div><div class="record-heading"><div><div class="record-class">{data.type.toUpperCase()} ENTITY // LEVEL {data.level}</div><h1>{data.title}</h1><p>{data.description}</p></div><div class:list={['data-badge',data.placeholder&&'placeholder']}><small>DATA STATUS</small><b>{data.dataStatus}</b></div></div></div></header>
<div class="container record-grid"><aside class="record-aside"><div class="frame-label"><span>ENCOUNTER VISUAL</span><span>{data.type.toUpperCase()}</span></div>{data.image?<img class="record-image" src={url(data.image)} alt={data.title}/>:<div class="record-image missing">IMAGE PENDING</div>}<dl class="record-facts"><div><dt>CLASS</dt><dd>{data.type}</dd></div><div><dt>LEVEL</dt><dd>{data.level}</dd></div><div><dt>LOCATION</dt><dd>{data.location}</dd></div></dl></aside>
<article class="record-content">{data.placeholder&&<div class="placeholder-notice"><b>EXAMPLE DATA</b><span>Values, requirements, attacks, and rewards are placeholders—not official Digimon Odyssey information.</span></div>}
  <section class="record-section"><div class="record-section-title"><span>01</span><h2>Overview</h2></div><p class="record-lead">{data.description}</p><slot/></section>
  <section class="record-section"><div class="record-section-title"><span>02</span><h2>Location</h2></div>{data.locationSlug?<a class="archive-note link" href={url(`/database/${data.locationSlug}/`)}>{data.location}<b>OPEN LOCATION RECORD →</b></a>:<div class="archive-note">{data.location}<small>LOCATION RECORD NOT YET LINKED</small></div>}</section>
  <section class="record-section"><div class="record-section-title"><span>03</span><h2>Access Requirements</h2></div><div class="requirement-grid"><div><small>MINIMUM LEVEL</small><b>{data.access.minimumLevel??'None recorded'}</b></div><div><small>PARTY</small><b>{data.access.party??'None recorded'}</b></div><div><small>QUESTS</small><ul>{data.access.quests.length?data.access.quests.map(v=><li>{v}</li>):<li>None recorded</li>}</ul></div><div><small>REQUIRED ITEMS</small><ul>{data.access.items.length?data.access.items.map(v=><li>{v}</li>):<li>None recorded</li>}</ul></div><div class="wide"><small>CUSTOM NOTES</small><ul>{data.access.notes.length?data.access.notes.map(v=><li>{v}</li>):<li>None recorded</li>}</ul></div></div></section>
  <section class="record-section"><div class="record-section-title"><span>04</span><h2>Stats</h2></div><div class="stat-grid">{statRows.map(([label,value])=><div><small>{label}</small><strong>{value}</strong>{data.placeholder&&<i>EXAMPLE</i>}</div>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>05</span><h2>Attacks</h2></div><div class="attack-list">{data.attacks.map((attack,i)=><article><div class="attack-index">ATK-{(i+1).toString().padStart(2,'0')}</div><div><h3>{attack.name}</h3><p>{attack.description}</p><dl><div><dt>POWER / DAMAGE</dt><dd>{attack.power??'—'}</dd></div><div><dt>EFFECTS</dt><dd>{attack.effect??'—'}</dd></div><div><dt>COOLDOWN / CONDITIONS</dt><dd>{attack.cooldown??'—'}</dd></div></dl></div></article>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>06</span><h2>Rewards</h2></div><div class="reward-grid">{rewardGroups.map(([label,items])=><div><small>{label}</small><ul>{items.length?items.map(v=><li>{v}</li>):<li>None recorded</li>}</ul></div>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>07</span><h2>Encounter Information</h2></div><div class="encounter-meta"><div><small>RESPAWN</small><b>{data.encounter.respawn??'Not recorded'}</b></div><div><small>PARTY SIZE</small><b>{data.encounter.partySize??'Not recorded'}</b></div></div><div class="encounter-groups"><div><small>ARENA / INSTANCE RULES</small><ul>{data.encounter.rules.map(v=><li>{v}</li>)}</ul></div><div><small>PHASES</small><ul>{data.encounter.phases.map(v=><li>{v}</li>)}</ul></div><div><small>SPECIAL MECHANICS</small><ul>{data.encounter.mechanics.map(v=><li>{v}</li>)}</ul></div></div></section>
  <section class="record-section"><div class="record-section-title"><span>08</span><h2>Related Entries</h2></div><div class="related-list">{data.related.length?data.related.map(item=><a href={relatedUrl(item)}><span>{item.collection.replace('-',' ').toUpperCase()}</span><b>{item.title}</b><i>OPEN ↗</i></a>):<p class="muted">No related entries recorded.</p>}</div></section>
</article></div></main></BaseLayout>

