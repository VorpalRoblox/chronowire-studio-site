---
import BaseLayout from './BaseLayout.astro';
const { entry }=Astro.props;
const data=entry.data;
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
const relatedUrl=(item)=>item.collection==='playable-digimon'?url(`/database/digimon/${item.slug}/`):item.collection==='enemies'?url(`/database/enemies/${item.slug}/`):url(`/database/${item.slug}/`);
const statRows=[['HP',data.stats.hp],['Attack',data.stats.attack],['Defense',data.stats.defense],['Speed',data.stats.speed],...Object.entries(data.stats.additional)].filter(([,value])=>value!==undefined);
---
<BaseLayout title={`${data.title} — ${data.type} Archive`} description={data.description} active="database"><main class="record-page enemy-record">
<header class="record-head"><div class="container"><div class="breadcrumb"><a href={url('/database/')}>ODYSSEY DATABASE</a> / {data.type.toUpperCase()} / <span>{data.slug.toUpperCase()}</span></div><div class="record-heading"><div><div class="record-class">{data.type.toUpperCase()} ENTITY // LEVEL {data.level}</div><h1>{data.title}</h1><p>{data.description}</p></div><div class="data-badge"><small>DATA STATUS</small><b>{data.dataStatus}</b></div></div></div></header>
<div class="container record-grid"><aside class="record-aside"><div class="frame-label"><span>ENCOUNTER RECORD</span><span>{data.type.toUpperCase()}</span></div>{data.image?<img class="record-image" src={url(data.image)} alt={data.title}/>:<div class="record-image missing">IMAGE PENDING</div>}<dl class="record-facts"><div><dt>CLASS</dt><dd>{data.type}</dd></div>{data.attribute&&<div><dt>ATTRIBUTE</dt><dd>{data.attribute}</dd></div>}<div><dt>BOSS LEVEL</dt><dd>{data.level}</dd></div><div><dt>LOCATION</dt><dd>{data.location}</dd></div></dl></aside>
<article class="record-content">
  <div class="access-alert"><div><small>ACCESS REQUIREMENT</small><strong>LEVEL {data.access.minimumLevel??'—'}</strong></div><div><small>DESTINATION</small><strong>{data.location}</strong></div></div>
  <section class="record-section first"><div class="record-section-title"><span>01</span><h2>Overview</h2></div><p class="record-lead">{data.description}</p><slot/></section>
  <section class="record-section"><div class="record-section-title"><span>02</span><h2>Location & Access</h2></div><div class="location-panel"><div><small>LOCATION</small><b>{data.location}</b></div><div><small>MINIMUM PLAYER LEVEL</small><b>{data.access.minimumLevel??'None'}</b></div></div>{(data.access.quests.length>0||data.access.items.length>0||data.access.party)&&<div class="requirement-grid">{data.access.quests.length>0&&<div><small>QUESTS</small><ul>{data.access.quests.map(v=><li>{v}</li>)}</ul></div>}{data.access.items.length>0&&<div><small>REQUIRED ITEMS</small><ul>{data.access.items.map(v=><li>{v}</li>)}</ul></div>}{data.access.party&&<div><small>PARTY</small><b>{data.access.party}</b></div>}</div>}</section>
  <section class="record-section"><div class="record-section-title"><span>03</span><h2>Stats</h2></div><div class="stat-grid">{statRows.map(([label,value])=><div><small>{label}</small><strong>{value}</strong></div>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>04</span><h2>Attacks</h2></div><div class="attack-list boss-attacks">{data.attacks.map((attack,i)=><article><div class="attack-index">ATK-{(i+1).toString().padStart(2,'0')}</div><div><h3>{attack.name}</h3><p>{attack.description}</p><dl><div><dt>DAMAGE</dt><dd>{attack.power??'—'}</dd></div>{attack.followUpDamage!==undefined&&<div><dt>FOLLOW-UP DAMAGE</dt><dd>{attack.followUpDamage}</dd></div>}<div><dt>COOLDOWN</dt><dd>{attack.cooldown??'—'}</dd></div></dl></div></article>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>05</span><h2>Base Rewards</h2></div><div class="base-rewards"><div><small>XP</small><strong>{data.rewards.exp??'—'}</strong></div><div><small>CASH</small><strong>{data.rewards.currency??'—'}</strong></div></div></section>
  <section class="record-section"><div class="record-section-title"><span>06</span><h2>Drop Table</h2></div><div class="drop-table"><div class="drop-head"><span>ITEM</span><span>CHANCE</span><span>QUANTITY</span></div>{data.rewards.drops.map(drop=><div><b>{drop.item}</b><span>{drop.chance}</span><span>{drop.amount}</span></div>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>07</span><h2>Encounter Information</h2></div><div class="respawn-panel"><small>RESPAWN TIME</small><strong>{data.encounter.respawn??'Not recorded'}</strong></div></section>
  {data.related.length>0&&<section class="record-section"><div class="record-section-title"><span>08</span><h2>Related Entries</h2></div><div class="related-list">{data.related.map(item=><a href={relatedUrl(item)}><span>{item.collection.replace('-',' ').toUpperCase()}</span><b>{item.title}</b><i>OPEN ↗</i></a>)}</div></section>}
</article></div></main></BaseLayout>

