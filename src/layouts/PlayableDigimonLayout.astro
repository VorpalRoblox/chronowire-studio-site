---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
const { entry }=Astro.props;
const data=entry.data;
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
const playable=await getCollection('playableDigimon',({data})=>!data.draft);
const names=new Map(playable.map(item=>[item.data.slug,item.data.title]));
const relatedUrl=(item)=>item.collection==='playable-digimon'?url(`/database/digimon/${item.slug}/`):item.collection==='enemies'?url(`/database/enemies/${item.slug}/`):url(`/database/${item.slug}/`);
const statRows=[['HP',data.stats.hp],['Attack',data.stats.attack],['Defense',data.stats.defense],['Speed',data.stats.speed],...Object.entries(data.stats.additional)].filter(([,value])=>value!==undefined);
const thumb=data.robloxAssetId?`https://www.roblox.com/asset-thumbnail/image?assetId=${data.robloxAssetId}&width=420&height=420&format=png`:data.image?url(data.image):null;
const fallback=data.image?url(data.image):'';
---
<BaseLayout title={`${data.title} — Playable Digimon Archive`} description={data.description} active="database"><main class="record-page">
<header class="record-head"><div class="container"><div class="breadcrumb"><a href={url('/database/')}>ODYSSEY DATABASE</a> / PLAYABLE DIGIMON / <span>{data.slug.toUpperCase()}</span></div><div class="record-heading"><div><div class="record-class">PLAYABLE DIGIMON // {data.stage.toUpperCase()}</div><h1>{data.title}</h1><p>{data.description}</p></div><div class="data-badge"><small>DATA STATUS</small><b>{data.dataStatus}</b></div></div></div></header>
<div class="container record-grid"><aside class="record-aside"><div class="frame-label"><span>ENTITY ICON</span><span>{data.robloxAssetId?`RBX ${data.robloxAssetId}`:data.slug.toUpperCase()}</span></div>{thumb?<img class="record-image" src={thumb} alt={`${data.title} icon`} onerror={fallback?`this.onerror=null;this.src='${fallback}'`:undefined}/>:<div class="record-image missing">IMAGE PENDING</div>}<dl class="record-facts"><div><dt>STAGE</dt><dd>{data.stage}</dd></div><div><dt>ATTRIBUTE</dt><dd>{data.attribute}</dd></div>{data.species&&<div><dt>TYPE / SPECIES</dt><dd>{data.species}</dd></div>}<div class="requirement-highlight"><dt>LEVEL REQUIREMENT</dt><dd>{data.requirements.level??'None'}</dd></div></dl></aside>
<article class="record-content">
  <section class="record-section first"><div class="record-section-title"><span>01</span><h2>Overview</h2></div><p class="record-lead">{data.description}</p><slot/></section>
  <section class="record-section"><div class="record-section-title"><span>02</span><h2>Stats</h2></div><div class="stat-grid">{statRows.map(([label,value])=><div><small>{label}</small><strong>{value}</strong></div>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>03</span><h2>Attacks</h2></div><div class="attack-list playable-attacks">{data.attacks.map((attack,i)=><article><div class="attack-index">ATK-{(i+1).toString().padStart(2,'0')}</div><div><div class="attack-title"><h3>{attack.name}</h3>{attack.key&&<kbd>{attack.key}</kbd>}</div><p>{attack.description}</p><dl><div><dt>REQUIRED LEVEL</dt><dd>{attack.requiredLevel??'—'}</dd></div><div><dt>COOLDOWN</dt><dd>{attack.cooldown??'—'}</dd></div></dl></div></article>)}</div></section>
  <section class="record-section"><div class="record-section-title"><span>04</span><h2>Digivolution</h2></div><div class="evolution-flow"><div>{data.digivolution.from.length?data.digivolution.from.map(ref=>names.has(ref.slug)?<a href={url(`/database/digimon/${ref.slug}/`)}><small>EVOLVES FROM</small><b>{ref.title}</b><i>OPEN ↗</i></a>:<div class="evolution-unlinked"><small>EVOLVES FROM // RECORD PENDING</small><b>{ref.title}</b></div>):<div class="evolution-unlinked"><small>EVOLVES FROM</small><b>None recorded</b></div>}</div><span>←</span><div class="evolution-current"><small>CURRENT</small><b>{data.title}</b></div><span>→</span><div>{data.digivolution.to.length?data.digivolution.to.map(ref=>names.has(ref.slug)?<a href={url(`/database/digimon/${ref.slug}/`)}><small>EVOLVES TO</small><b>{ref.title}</b><i>OPEN ↗</i></a>:<div class="evolution-unlinked"><small>EVOLVES TO // RECORD PENDING</small><b>{ref.title}</b></div>):<div class="evolution-unlinked"><small>EVOLVES TO</small><b>None recorded</b></div>}</div></div></section>
  <section class="record-section"><div class="record-section-title"><span>05</span><h2>Requirements & Acquisition</h2></div><div class="requirement-grid"><div><small>LEVEL</small><b>{data.requirements.level??'None'}</b></div><div><small>ITEM</small><b>{data.requirements.items.length?data.requirements.items.join(', '):'None'}</b></div>{data.requirements.quests.length>0&&<div><small>QUESTS</small><ul>{data.requirements.quests.map(v=><li>{v}</li>)}</ul></div>}{data.requirements.bond&&<div><small>BOND / FRIENDSHIP</small><b>{data.requirements.bond}</b></div>}</div><div class="archive-note acquisition-note">{data.acquisition}</div></section>
  <section class="record-section"><div class="record-section-title"><span>06</span><h2>Related Entries</h2></div><div class="related-list">{data.related.length?data.related.map(item=><a href={relatedUrl(item)}><span>{item.collection.replace('-',' ').toUpperCase()}</span><b>{item.title}</b><i>OPEN ↗</i></a>):<p class="muted">No related entries recorded.</p>}</div></section>
</article></div></main></BaseLayout>

