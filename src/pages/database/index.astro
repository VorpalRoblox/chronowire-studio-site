---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
const entries=(await getCollection('database',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order||a.data.title.localeCompare(b.data.title));
const cats=['Digimon','Locations','Items','Systems','Quests','NPCs','Guides'];
---
<BaseLayout title="Odyssey Database — Chronowire Studio" active="database"><main>
<section class="archive-head database-head"><div class="container archive-head-grid"><div><div class="breadcrumb">PROJECT 01 / FIELD ARCHIVE / PUBLIC ACCESS</div><div class="section-kicker">ODYSSEY DATABASE</div><h1>Search the<br/><em>Archive</em></h1><p class="lead">Indexed field data for Digimon Odyssey—entities, locations, equipment, systems, missions, and operational guides.</p></div><div class="archive-stat"><small>INDEXED RECORDS</small><strong>{entries.length.toString().padStart(2,'0')}</strong><span>ACCESS // OPEN</span></div></div></section>
<section class="archive-controls"><div class="container"><label class="search-wrap"><span>QUERY //</span><input id="dbSearch" class="search" placeholder="Search archive records…" autocomplete="off"/></label><div class="category-filters" id="dbFilters"><button class="active" data-category="all">ALL <i>{entries.length}</i></button>{cats.map(c=><button data-category={c}>{c.toUpperCase()} <i>{entries.filter(e=>e.data.category===c).length}</i></button>)}</div></div></section>
<section class="section database-section"><div class="container"><div class="db-header"><span>ID</span><span>RECORD</span><span>CATEGORY</span><span>ACCESS</span></div><div class="db-list">{entries.map((entry,i)=><a class="db-card" data-category={entry.data.category} data-search={`${entry.data.title} ${entry.data.description} ${entry.data.category}`.toLowerCase()} href={url(`/database/${entry.id}/`)}><span class="db-id">OD-{(i+1).toString().padStart(3,'0')}</span><div><h2>{entry.data.title}</h2><p>{entry.data.description}</p></div><span class="type">{entry.data.category}</span><b>OPEN ↗</b></a>)}</div><div class="empty" id="empty">NO RECORDS MATCH THE CURRENT QUERY.</div></div></section>
</main><script is:inline>const search=document.querySelector('#dbSearch'),cards=[...document.querySelectorAll('.db-card')],buttons=[...document.querySelectorAll('#dbFilters button')],empty=document.querySelector('#empty');let category=new URLSearchParams(location.search).get('category')||'all';function apply(){const q=(search?.value||'').toLowerCase();let shown=0;cards.forEach(c=>{const show=c.dataset.search.includes(q)&&(category==='all'||c.dataset.category===category);c.hidden=!show;if(show)shown++});buttons.forEach(b=>b.classList.toggle('active',b.dataset.category===category));empty.style.display=shown?'none':'block'}buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category;apply()}));search?.addEventListener('input',apply);apply();</script></BaseLayout>

