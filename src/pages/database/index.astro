---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
const playable=(await getCollection('playableDigimon',({data})=>!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const enemies=(await getCollection('enemies',({data})=>!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const archive=(await getCollection('database',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order||a.data.title.localeCompare(b.data.title));
const enemyEntries=enemies.filter(entry=>entry.data.type==='Enemy');
const bossEntries=enemies.filter(entry=>entry.data.type==='Boss');
const total=playable.length+enemies.length+archive.length;
---
<BaseLayout title="Odyssey Database — Chronowire Studio" active="database"><main>
<section class="archive-head database-head"><div class="container archive-head-grid"><div><div class="breadcrumb">PROJECT 01 / FIELD ARCHIVE / PUBLIC ACCESS</div><div class="section-kicker">ODYSSEY DATABASE</div><h1>Search the<br/><em>Archive</em></h1><p class="lead">Structured field data for playable Digimon, enemy entities, boss encounters, systems, and operational guides.</p></div><div class="archive-stat"><small>INDEXED RECORDS</small><strong>{total.toString().padStart(2,'0')}</strong><span>ACCESS // OPEN</span></div></div></section>
<section class="archive-controls"><div class="container"><label class="search-wrap"><span>QUERY //</span><input id="dbSearch" class="search" placeholder="Search names, stages, locations, or categories…" autocomplete="off"/></label><div class="category-filters" id="dbFilters"><button class="active" data-category="all">ALL <i>{total}</i></button><button data-category="playable">PLAYABLE DIGIMON <i>{playable.length}</i></button><button data-category="enemy">ENEMIES <i>{enemyEntries.length}</i></button><button data-category="boss">BOSSES <i>{bossEntries.length}</i></button><button data-category="archive">ARCHIVE RECORDS <i>{archive.length}</i></button></div></div></section>
<section class="section database-section"><div class="container">
  <div class="database-group"><div class="database-group-head"><div><span>TYPE // 01</span><h2>Playable Digimon</h2></div><b>{playable.length.toString().padStart(2,'0')} RECORDS</b></div><div class="db-list">{playable.map((entry,i)=><a class="db-card" data-category="playable" data-search={`${entry.data.title} playable ${entry.data.stage} ${entry.data.attribute} ${entry.data.species} ${entry.data.description}`.toLowerCase()} href={url(`/database/digimon/${entry.data.slug}/`)}><span class="db-id">DG-{(i+1).toString().padStart(3,'0')}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><span class="type">{entry.data.stage}</span><span class:list={['data-state',entry.data.placeholder&&'placeholder']}>{entry.data.dataStatus}</span><b>OPEN ↗</b></a>)}</div></div>
  <div class="database-group"><div class="database-group-head"><div><span>TYPE // 02</span><h2>Enemies</h2></div><b>{enemyEntries.length.toString().padStart(2,'0')} RECORDS</b></div>{enemyEntries.length?<div class="db-list">{enemyEntries.map((entry,i)=><a class="db-card" data-category="enemy" data-search={`${entry.data.title} enemy ${entry.data.location} ${entry.data.description}`.toLowerCase()} href={url(`/database/enemies/${entry.data.slug}/`)}><span class="db-id">EN-{(i+1).toString().padStart(3,'0')}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><span class="type">Enemy</span><span class="data-state">LV. {entry.data.level}</span><b>OPEN ↗</b></a>)}</div>:<div class="group-empty" data-empty-category="enemy">NO ENEMY RECORDS INDEXED.</div>}</div>
  <div class="database-group"><div class="database-group-head"><div><span>TYPE // 03</span><h2>Bosses</h2></div><b>{bossEntries.length.toString().padStart(2,'0')} RECORDS</b></div><div class="db-list">{bossEntries.map((entry,i)=><a class="db-card" data-category="boss" data-search={`${entry.data.title} boss ${entry.data.location} ${entry.data.description}`.toLowerCase()} href={url(`/database/enemies/${entry.data.slug}/`)}><span class="db-id">BS-{(i+1).toString().padStart(3,'0')}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><span class="type boss">Boss</span><span class:list={['data-state',entry.data.placeholder&&'placeholder']}>LV. {entry.data.level}</span><b>OPEN ↗</b></a>)}</div></div>
  <div class="database-group"><div class="database-group-head"><div><span>TYPE // 04</span><h2>Archive Records</h2></div><b>{archive.length.toString().padStart(2,'0')} RECORDS</b></div><div class="db-list">{archive.map((entry,i)=><a class="db-card" data-category="archive" data-search={`${entry.data.title} ${entry.data.category} ${entry.data.description}`.toLowerCase()} href={url(`/database/${entry.id}/`)}><span class="db-id">AR-{(i+1).toString().padStart(3,'0')}</span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><span class="type">{entry.data.category}</span><span class="data-state">REFERENCE</span><b>OPEN ↗</b></a>)}</div></div>
  <div class="empty" id="empty">NO RECORDS MATCH THE CURRENT QUERY.</div>
</div></section>
</main><script is:inline>const search=document.querySelector('#dbSearch'),cards=[...document.querySelectorAll('.db-card')],buttons=[...document.querySelectorAll('#dbFilters button')],groups=[...document.querySelectorAll('.database-group')],empty=document.querySelector('#empty');let category=new URLSearchParams(location.search).get('category')||'all';function apply(){const q=(search?.value||'').toLowerCase();let shown=0;cards.forEach(c=>{const show=c.dataset.search.includes(q)&&(category==='all'||c.dataset.category===category);c.hidden=!show;if(show)shown++});groups.forEach(g=>{const visible=g.querySelectorAll('.db-card:not([hidden])').length;g.hidden=!visible});buttons.forEach(b=>b.classList.toggle('active',b.dataset.category===category));empty.style.display=shown?'none':'block'}buttons.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category;apply()}));search?.addEventListener('input',apply);apply();</script></BaseLayout>

