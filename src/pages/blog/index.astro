---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Transmission Log — Chronowire Studio" active="blogs"><main>
<section class="archive-head"><div class="container archive-head-grid"><div><div class="breadcrumb">CHRONOWIRE / PROJECT 01 / TRANSMISSIONS</div><div class="section-kicker">DEVELOPMENT CHANNEL</div><h1>Transmission<br/><em>Log</em></h1><p class="lead">Chronological development records, announcements, field notes, and release information from Chronowire Studio.</p></div><div class="archive-stat"><small>LOGGED RECORDS</small><strong>{posts.length.toString().padStart(2,'0')}</strong><span>STATUS // ONLINE</span></div></div></section>
<section class="section log-section"><div class="container"><div class="log-header"><span>RECORD</span><span>TRANSMISSION</span><span>CLASSIFICATION</span><span>DATE</span></div><div class="log-list">{posts.map((post,i)=><a href={url(`/blog/${post.id}/`)}><span class="log-number">TX-{(i+1).toString().padStart(3,'0')}</span><div><h2>{post.data.title}</h2><p>{post.data.description}</p></div><div class="log-tags"><span>{post.data.category}</span><small>{post.data.project}</small></div><time>{post.data.pubDate.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}).toUpperCase()}</time></a>)}</div></div></section>
</main></BaseLayout>

