---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const url = (path) => `${base}${path.replace(/^\//,'')}`;
const posts = (await getCollection('blog', ({data}) => !data.draft))
.sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Updates — Chronowire Studio" active="blogs">
<main><section class="page-hero"><div class="container"><span class="eyebrow">Studio Updates</span><h1>Latest <span>news.</span></h1><p class="lead">Development blogs, announcements, patch notes, and behind-the-scenes progress from Chronowire Studio.</p></div></section>
<section class="section" style="padding-top:20px"><div class="container"><div class="cards">
{posts.map(post => <a class="card" href={url(`/blog/${post.id}/`)}><span class="tag">{post.data.category}</span><div class="meta" style="margin-top:12px">{post.data.pubDate.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})} · {post.data.project}</div><h3>{post.data.title}</h3><p class="muted">{post.data.description}</p></a>)}
</div></div></section></main>
</BaseLayout>
