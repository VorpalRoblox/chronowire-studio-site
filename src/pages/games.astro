---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const url = (path) => `${base}${path.replace(/^\//,'')}`;
---
<BaseLayout title="Games — Chronowire Studio" active="games">
<main><section class="page-hero"><div class="container"><span class="eyebrow">Games</span><h1>Our <span>projects.</span></h1><p class="lead">Chronowire Studio currently has one featured project: Digimon Odyssey.</p></div></section>
<section class="section" style="padding-top:25px"><div class="container game-page-grid">
<aside class="game-side"><a class="side-icon" href="https://www.roblox.com/games/92494551546395/Digimon-Odyssey" target="_blank"><img src={url('/images/digimon-odyssey-icon.png')} alt="Digimon Odyssey icon" /></a><ul class="facts"><li><span>Platform</span><b>Roblox</b></li><li><span>Studio</span><b>Chronowire</b></li><li><span>Status</span><b>In development</b></li><li><span>Genre</span><b>Adventure / RPG</b></li></ul><a class="btn btn-orange" href="https://www.roblox.com/games/92494551546395/Digimon-Odyssey" target="_blank" style="width:100%">Play on Roblox ↗</a></aside>
<div><div class="section-kicker">Digimon Odyssey</div><h2 style="font-size:52px;margin:8px 0 16px;letter-spacing:-.055em">Begin your Odyssey.</h2><p class="lead">The official Chronowire Studio hub for Digimon Odyssey information, development updates, and its growing community database.</p>
<div class="cards" style="grid-template-columns:1fr 1fr;margin-top:30px"><a class="card" href={url('/database/')}><h3>Game Database</h3><p class="muted">Browse entries for Digimon, locations, items, systems, quests, NPCs, and progression.</p><b>Browse database →</b></a><a class="card" href={url('/blog/')}><h3>Latest Updates</h3><p class="muted">Development blogs, announcements, previews, patch notes, and release news.</p><b>View updates →</b></a></div>
</div></div></section></main>
</BaseLayout>
