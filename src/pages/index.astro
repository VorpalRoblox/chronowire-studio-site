---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base.replace(/\/+$/,'')}/${path.replace(/^\/+/, '')}`;
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const entries=(await getCollection('database',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order);
const playableEntries=await getCollection('playableDigimon',({data})=>!data.draft);
const enemyEntries=await getCollection('enemies',({data})=>!data.draft);
const discoveries=[
  ...playableEntries.map(entry=>({title:entry.data.title,category:'Playable Digimon',description:entry.data.description,href:url(`/database/digimon/${entry.data.slug}/`)})),
  ...enemyEntries.map(entry=>({title:entry.data.title,category:entry.data.type,description:entry.data.description,href:url(`/database/enemies/${entry.data.slug}/`)})),
  ...entries.map(entry=>({title:entry.data.title,category:entry.data.category,description:entry.data.description,href:url(`/database/${entry.id}/`)})),
];
const recordCount=discoveries.length;
const featured=posts.find(p=>p.data.featured)??posts[0];
const categories=[
  {label:'Playable Digimon',filter:'playable'}, {label:'Enemies',filter:'enemy'}, {label:'Bosses',filter:'boss'},
  {label:'Systems',filter:'archive'}, {label:'Quests',filter:'archive'}, {label:'Guides',filter:'archive'},
];
---
<BaseLayout active="home"><main>
<section class="project-hero"><div class="container hero-shell">
  <div class="hero-copy"><div class="project-label"><span>PROJECT // 01</span><b>IN DEVELOPMENT</b></div><h1><small>CHRONOWIRE PRESENTS</small>DIGIMON<br/><em>ODYSSEY</em></h1><p class="lead">An evolving Roblox adventure built around exploration, progression, discovery, and a world designed to be documented.</p><div class="actions"><a class="btn btn-orange" href="https://www.roblox.com/games/92494551546395/Digimon-Odyssey" target="_blank" rel="noreferrer">Play on Roblox ↗</a><a class="btn" href={url('/database/')}>Open Database</a><a class="btn btn-ghost" href={url('/blog/')}>View Updates</a></div><dl class="hero-data"><div><dt>PLATFORM</dt><dd>Roblox</dd></div><div><dt>GENRE</dt><dd>Adventure / RPG</dd></div><div><dt>RECORDS</dt><dd>{recordCount.toString().padStart(2,'0')}</dd></div></dl></div>
  <div class="hero-media-wrap"><div class="frame-label"><span>FIELD VISUAL // LIVE ROTATION</span><span>16:9</span></div><a class="game-art slideshow" href="https://www.roblox.com/games/92494551546395/Digimon-Odyssey" target="_blank" rel="noreferrer" aria-label="Play Digimon Odyssey on Roblox"><img class="slide active" src={url('/images/digimon-slide-evolve.webp')} alt="Digimon Odyssey evolution thumbnail"/><img class="slide" src={url('/images/digimon-slide-level-300.webp')} alt="Digimon Odyssey level 300 thumbnail"/><img class="slide" src={url('/images/digimon-slide-agumon.webp')} alt="Digimon Odyssey Agumon thumbnail"/><span class="slide-dots" aria-hidden="true"><i class="active"></i><i></i><i></i></span></a></div>
</div></section>
<section class="section transmission-section"><div class="container"><div class="section-head"><div><div class="section-kicker">CHANNEL // DEVELOPMENT</div><h2>Latest Transmission</h2></div><a href={url('/blog/')} class="text-link">OPEN TRANSMISSION LOG →</a></div>{featured?<a class="transmission" href={url(`/blog/${featured.id}/`)}><div class="transmission-index">TX-{featured.data.pubDate.getFullYear().toString().slice(-2)}.01</div><div><div class="meta-line"><span>{featured.data.category}</span><time>{featured.data.pubDate.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}).toUpperCase()}</time><span>{featured.data.project}</span></div><h3>{featured.data.title}</h3><p>{featured.data.description}</p></div><b>READ<br/>RECORD ↗</b></a>:<div class="empty-state">NO TRANSMISSIONS LOGGED.</div>}</div></section>
<section class="section archive-preview"><div class="container archive-layout"><div class="archive-intro"><div class="section-kicker">ARCHIVE // ODYSSEY DATABASE</div><h2>Field knowledge,<br/>indexed.</h2><p class="muted">A growing reference system for the people, places, mechanics, and discoveries that define Digimon Odyssey.</p><a class="btn" href={url('/database/')}>Enter Archive →</a></div><div class="category-matrix">{categories.map((category,i)=><a href={`${url('/database/')}?category=${category.filter}`}><small>{(i+1).toString().padStart(2,'0')}</small><span>{category.label}</span><b>↗</b></a>)}</div></div></section>
<section class="section discoveries"><div class="container"><div class="section-head"><div><div class="section-kicker">RECENTLY INDEXED</div><h2>Recent Discoveries</h2></div><span class="record-count">{recordCount} TOTAL RECORDS</span></div><div class="discovery-list">{discoveries.slice(0,3).map((entry,i)=><a href={entry.href}><span>{(i+1).toString().padStart(2,'0')}</span><div><small>{entry.category}</small><h3>{entry.title}</h3></div><p>{entry.description}</p><b>OPEN ↗</b></a>)}</div></div></section>
</main><script is:inline>const slides=[...document.querySelectorAll('.slideshow .slide')],dots=[...document.querySelectorAll('.slideshow .slide-dots i')];if(slides.length>1&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){let current=0;window.setInterval(()=>{slides[current].classList.remove('active');dots[current]?.classList.remove('active');current=(current+1)%slides.length;slides[current].classList.add('active');dots[current]?.classList.add('active')},5000)}</script></BaseLayout>


